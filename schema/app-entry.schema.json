{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "byStore App Entry",
  "type": "object",
  "required": ["id", "title", "version", "min_byos_version", "author", "sha256", "size_bytes", "download_url", "publisher_github"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$" },
    "title": { "type": "string", "minLength": 2 },
    "version": { "type": "string" },
    "min_byos_version": { "type": "string" },
    "max_byos_version": { "type": ["string", "null"] },
    "author": { "type": "string" },
    "publisher_github": { "type": "string" },
    "category": { "type": "string" },
    "summary": { "type": "string" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "size_bytes": { "type": "integer", "minimum": 1 },
    "download_url": { "type": "string", "format": "uri" }
  }
}
