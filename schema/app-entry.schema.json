{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "byStore App Entry",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "icon",
    "min_byos_version",
    "author",
    "sha256",
    "size_bytes",
    "download_url",
    "publisher_github"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$" },
    "title": { "type": "string", "minLength": 2 },
    "version": { "type": "string", "minLength": 1 },
    "icon": {
      "type": "string",
      "minLength": 5,
      "description": "Caminho relativo no repositório (ex: icons/meu-app.png ou .svg) ou URL HTTPS do ícone exibido na byStore."
    },
    "min_byos_version": { "type": "string", "minLength": 1 },
    "max_byos_version": { "type": ["string", "null"] },
    "author": { "type": "string", "minLength": 2 },
    "publisher_github": { "type": "string", "minLength": 1 },
    "category": { "type": "string" },
    "summary": { "type": "string" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "size_bytes": { "type": "integer", "minimum": 1 },
    "download_url": { "type": "string", "format": "uri" }
  }
}
